{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch",
            "type": "cppdbg",
            "request": "launch",
            //"program": "${workspaceFolder}/build/programs/clickhouse-server",
            //"program": "${workspaceFolder}/build/programs/clickhouse-client",
            "program": "${workspaceFolder}/build/programs/clickhouse-local",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "ignore SIGUSR1 signal",
                    "text": "handle SIGUSR1 nostop noprint pass"
                },
                {
                    "description": "ignore SIGUSR2 signal",
                    "text": "handle SIGUSR2 nostop noprint pass"
                }//,
               // {
               //     "description": "gdb pretty",
               //     "text": "source ~/src/pretty-printer/ClickHouse-pretty-printer/gdbinit"
               // } 

            ]
        }
    ]
}